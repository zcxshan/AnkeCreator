{
  "name": "anke-creator",
  "version": "2.2.0",
  "description": "安科作者助手 - 一款为安科/安价创作设计的写作工具",
  "main": "dist-electron/main.js",
  "author": "点点星辰",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:zcxshan/AnkeCreator.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --publish never",
    "build:icons": "node scripts/generate-icon.js",
    "build:full": "npm run build:icons && tsc && vite build && electron-builder --publish never && node scripts/clear-icon-cache.js",
    "build:win": "npm run build && electron-builder --win --x64",
    "build-web": "tsc && vite build --mode production",
    "preview": "vite preview",
    "cap:sync": "npm run build-web && cap sync",
    "cap:open:android": "cap open android",
    "cap:build:apk": "npm run cap:sync && gradle -p android assembleDebug --no-daemon",
    "cap:build:apk:release": "npm run cap:sync && gradle -p android assembleRelease --no-daemon",
    "apk:debug": "npm run cap:build:apk",
    "apk:release": "npm run cap:build:apk:release",
    "keystore:gen": "node scripts/generate-keystore.js"
  },
  "dependencies": {
    "@capacitor/browser": "^6.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.1",
    "@capacitor/share": "^6.0.1",
    "@capacitor/status-bar": "^6.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "to-ico": "^1.1.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.shanshian.ankecreator",
    "productName": "安科作者助手",
    "copyright": "Copyright © 2026 点点星辰 (zcxshan)",
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}-${env.BUILD_TYPE:-setup}.${ext}",
    "asar": true,
    "compression": "normal",
    "removePackageScripts": true,
    "electronLanguages": [
      "zh-CN"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "点点星辰"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "安科作者助手",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "runAfterFinish": true,
      "license": "build/LICENSE.txt"
    }
  }
}
