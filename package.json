{
  "name": "anke-creator",
  "version": "3.5.0",
  "description": "安科作者助手 - 一款为安科/安价创作设计的写作工具",
  "main": "dist-electron/main.js",
  "author": "星星的辰",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:zcxshan/AnkeCreator.git"
  },
  "scripts": {
    "sync:icons": "node scripts/sync-android-icons.js",
    "android:sync": "npm run sync:icons && npx cap sync android",
    "ios:sync": "npm run sync:icons && npx cap sync ios",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build:icons": "node scripts/generate-icon.js",
    "build:full": "npm run build:icons && tsc && vite build && electron-builder --publish never && node scripts/clear-icon-cache.js",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "build-web": "tsc && vite build --mode production",
    "preview": "vite preview",
    "cap:sync": "npm run build-web && cap sync",
    "cap:open:android": "cap open android",
    "cap:build:apk": "npm run cap:sync && gradle -p android assembleDebug --no-daemon",
    "cap:build:apk:release": "npm run cap:sync && gradle -p android assembleRelease --no-daemon",
    "apk:debug": "npm run cap:build:apk",
    "apk:release": "npm run cap:build:apk:release",
    "keystore:gen": "node scripts/generate-keystore.js"
  },
  "dependencies": {
    "@capacitor/browser": "^6.0.6",
    "@types/react-window": "^1.8.8",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.1",
    "@capacitor/share": "^6.0.1",
    "@capacitor/status-bar": "^6.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "to-ico": "^1.1.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.shanshian.ankecreator",
    "productName": "安科作者助手",
    "copyright": "Copyright © 2026 星星的辰",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "normal",
    "removePackageScripts": true,
    "electronLanguages": [
      "zh-CN"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "星星的辰"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "安科作者助手",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "runAfterFinish": true,
      "license": "build/LICENSE.txt",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
