# 依赖包 — 完全忽略
node_modules/
jspm_packages/

# 构建产物 — 每次构建重新生成，完全忽略
dist/
dist-electron/
release/
out/

# build 目录 — 仅保留 icon.png（electron-builder 需要），其他全部忽略
build/*
!build/icon.png

# 编译缓存 — 完全忽略
*.tsbuildinfo
.vite/
.cache/
.parcel-cache/
.eslintcache
.prettiercache

# 数据库 — 仅保留 schema.sql（表结构定义），所有数据文件忽略
database/*.db
database/*.sqlite
database/*.sqlite3
database/data/
database/*.dump
!database/schema.sql

# SQLite 运行时临时文件（WAL / SHM）
database/*.db-wal
database/*.db-shm
database/*.sqlite-wal
database/*.sqlite-shm
database/*.sqlite3-wal
database/*.sqlite3-shm

# 临时测试资源 — 完全忽略
smile.png
scripts/

# IDE / AI 助手配置 — 完全忽略
.trae/
.codebuddy/
.vscode/
.idea/
*.swp
*.swo

# AI 代理文件
agent.md
Agent.md
!AGENT.md
*~

# 环境变量与密钥 — 完全忽略（绝对不能提交！）
.env
.env.local
.env.*.local

# 测试与覆盖率 — 完全忽略
coverage/
.nyc_output/
*.lcov

# 日志文件 — 完全忽略
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 临时笔记 — 完全忽略
temp.md
up.txt
i*.txt
*.md.tmp

# Electron 打包产物（兜底规则）
electron/dist/
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
electron-builder*.yml
electron-builder*.yaml

# 包管理器锁文件策略
# 注意：package-lock.json 应提交以保证团队依赖一致性
# 以下仅忽略其损坏/备份版本
package-lock.json.bak
npm-shrinkwrap.json

# 用户数据目录（应用运行时可能生成）
userData/
user-data/
app-data/
localData/
data/

# macOS 系统生成文件
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Windows 系统生成文件
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db

# 通用备份文件
*.bak
*.backup
*.old
*.orig
